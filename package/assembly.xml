<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
    <id>extension</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- Everything staged under target/to-be-packed goes into one directory
         named for the extension: the jars, plugin.xml, and the webadmin/
         tree the web administrator discovers. The assembly plugin writes an
         explicit entry for every directory level, which the engine's
         extension installer requires in order to create webadmin/ and
         webadmin/web/ before writing into them. -->
    <fileSets>
        <fileSet>
            <directory>${project.build.directory}/to-be-packed</directory>
            <outputDirectory>${packageName}</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
